<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.resq.app">

    <!-- Offline Mesh & Radio Permissions (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Local Wi-Fi P2P (for Nearby Connections High-Bandwidth Mode) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />

    <!-- GPS & Location Permissions (No internet required) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Physical Sensors for Fall Detection -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Foreground Execution & Battery Safety -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="ResQ"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
        </activity>

        <!-- Screen 1: Splash Screen (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ResQ"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Onboarding Screen -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.ResQ"
            android:screenOrientation="portrait" />

        <!-- Screen 3: Home Dashboard Activity -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.ResQ"
            android:screenOrientation="portrait"
            android:label="@string/app_name" />

        <!-- Screen 4: Emergency Message Activity -->
        <activity
            android:name=".ui.message.EmergencyMessageActivity"
            android:exported="false"
            android:theme="@style/Theme.ResQ"
            android:screenOrientation="portrait" />

        <!-- Screen 5: Nearby Devices Activity -->
        <activity
            android:name=".ui.devices.NearbyDevicesActivity"
            android:exported="false"
            android:theme="@style/Theme.ResQ"
            android:screenOrientation="portrait" />

        <!-- Screen 6: Inbox Activity -->
        <activity
            android:name=".ui.inbox.InboxActivity"
            android:exported="false"
            android:theme="@style/Theme.ResQ"
            android:screenOrientation="portrait" />

        <!-- Screen 7: Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ResQ"
            android:screenOrientation="portrait" />

        <!-- Ongoing ResQ Mesh & Safety Foreground Service -->
        <service
            android:name=".service.ResQForegroundService"
            android:foregroundServiceType="connectedDevice|location"
            android:exported="false" />

        <!-- Broadcast receiver for battery discharge threshold crossings -->
        <receiver
            android:name=".battery.BatteryStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="android.intent.action.POWER_CONNECTED" />
                <action android:name="android.intent.action.POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
