<?xml version="1.0" encoding="utf-8"?>
<!-- ResQ Android Material 3 Nearby Devices Screen -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_deep">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_navy_deep"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mesh Radar &amp; Devices"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanRadar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🔄 Scan"
            android:textColor="@color/cyan_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cyan_glow"
            app:strokeColor="@color/cyan_accent"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Mesh Topology Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="@color/cyan_accent"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connected Mesh Peers"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Direct BLE &amp; Multi-Hop Relays (Zero Internet)"
                            android:textColor="@color/text_slate_muted"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AES-128"
                        android:textColor="@color/cyan_accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_status_pill"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Peer 1: Ravi (Primary Buddy) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPeerRavi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="🛡️"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/bg_card_rounded" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ravi (Primary Buddy)"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45 meters away • Battery: 82%"
                                android:textColor="@color/text_slate_muted"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safe"
                            android:textColor="@color/safe_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:paddingTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📶 -58 dBm • Direct BLE (Hop 0)"
                            android:textColor="@color/cyan_accent"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPingRavi"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Ping"
                            android:textColor="@color/text_white"
                            android:textSize="10sp"
                            app:backgroundTint="@color/bg_surface_dark"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Peer 2: Priya -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPeerPriya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="📱"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/bg_card_rounded" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Priya"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="115 meters away • Battery: 38%"
                                android:textColor="@color/text_slate_muted"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Far From Group"
                            android:textColor="@color/p1_orange"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_pill"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:paddingTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📶 -81 dBm • Direct BLE (Hop 0)"
                            android:textColor="@color/cyan_accent"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPingPriya"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Ping"
                            android:textColor="@color/text_white"
                            android:textSize="10sp"
                            app:backgroundTint="@color/bg_surface_dark"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Peer 3: Anil (1-Hop via Ravi) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPeerAnil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="📍"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:background="@drawable/bg_card_rounded" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Anil (At Camp Alpha)"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="190 meters away • Battery: 91%"
                                android:textColor="@color/text_slate_muted"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safe"
                            android:textColor="@color/safe_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp"
                        android:paddingTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📶 -89 dBm • 1-Hop via Ravi (Hop 1)"
                            android:textColor="@color/cyan_accent"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTraceAnil"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Trace"
                            android:textColor="@color/text_white"
                            android:textSize="10sp"
                            app:backgroundTint="@color/bg_surface_dark"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_surface_dark"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/cyan_accent"
        app:itemTextColor="@color/text_slate_light"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
