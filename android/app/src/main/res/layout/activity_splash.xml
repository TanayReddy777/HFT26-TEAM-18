<?xml version="1.0" encoding="utf-8"?>
<!-- ResQ Android Material 3 Splash Screen -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_deep">

    <!-- Center Brand Group -->
    <LinearLayout
        android:id="@+id/brandGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Shield Icon with Glow -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_card_rounded">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_logo"
                app:tint="@color/cyan_accent"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_white"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginTop="20dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE EMERGENCY SAFETY"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginTop="4dp" />

        <!-- Mesh Protocol Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zero-Internet BLE &amp; Wi-Fi Mesh Network"
            android:textColor="@color/text_slate_muted"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

        <!-- Material 3 Loading Progress -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/splashProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/cyan_accent"
            app:trackColor="@color/bg_card_slate"
            app:trackThickness="3dp"
            app:indicatorSize="32dp"
            android:layout_marginTop="40dp" />
    </LinearLayout>

    <!-- Bottom Footer Meta -->
    <TextView
        android:id="@+id/tvFooterMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CBIT Hacktoberfest '26 • Team 18"
        android:textColor="@color/text_slate_muted"
        android:textSize="11sp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
