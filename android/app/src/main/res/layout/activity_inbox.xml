<?xml version="1.0" encoding="utf-8"?>
<!-- ResQ Android Material 3 Inbox Screen -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_deep">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_navy_deep"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Mesh Inbox"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End-to-End Encrypted • Store-and-Forward"
                android:textColor="@color/cyan_accent"
                android:textSize="10sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Message Feed -->
    <ScrollView
        android:id="@+id/scrollInbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/composerBar">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Message 1 (Incoming from Ravi with Telugu translation) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:justifyContent="space-between">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ravi (Primary Buddy) [P1]"
                            android:textColor="@color/cyan_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 mins ago"
                            android:textColor="@color/text_slate_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="వంతెన దగ్గర ఉన్నాము, సహాయం కావాలి."
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />

                    <!-- Translation Pill -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗣️ Translated: We are near the bridge, need help."
                        android:textColor="@color/text_slate_light"
                        android:textSize="11sp"
                        android:background="@drawable/bg_status_pill"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓✓ Delivered (1-Hop Relay)"
                        android:textColor="@color/safe_green"
                        android:textSize="10sp"
                        android:gravity="end"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Message 2 (Outgoing from You) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:backgroundTint="#1E3A5F"
                app:strokeColor="#2563EB"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:justifyContent="space-between">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You (Local Node)"
                            android:textColor="#93C5FD"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 min ago"
                            android:textColor="@color/text_slate_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acknowledged. Head towards Camp Alpha rendezvous point."
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓✓ STORED (Ack 2/2 Peers)"
                        android:textColor="@color/safe_green"
                        android:textSize="10sp"
                        android:gravity="end"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Composer Bar -->
    <LinearLayout
        android:id="@+id/composerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@color/bg_surface_dark"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <EditText
            android:id="@+id/etInboxMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:hint="Type offline mesh message..."
            android:textColorHint="@color/text_slate_muted"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:paddingHorizontal="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendMsg"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="➤"
            android:textColor="@color/bg_navy_deep"
            android:textSize="16sp"
            app:backgroundTint="@color/cyan_accent"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Bottom Nav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_surface_dark"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/cyan_accent"
        app:itemTextColor="@color/text_slate_light"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
