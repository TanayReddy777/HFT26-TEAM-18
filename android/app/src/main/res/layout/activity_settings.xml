<?xml version="1.0" encoding="utf-8"?>
<!-- ResQ Android Material 3 Settings Screen -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_deep">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_navy_deep"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety &amp; Mesh Settings"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Power Conservation State Machine -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:justifyContent="space-between">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔋 Power Conservation Bands"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPowerBandTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NORMAL (85%)"
                            android:textColor="@color/safe_green"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_pill"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-adapts BLE transmit power and GPS intervals as phone battery discharges."
                        android:textColor="@color/text_slate_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1.0"
                        android:valueTo="100.0"
                        android:value="85.0"
                        app:thumbColor="@color/cyan_accent"
                        app:trackColorActive="@color/cyan_accent"
                        app:trackColorInactive="@color/border_card"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Group Meeting Point (Rendezvous) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Group Meeting Point (Rendezvous)"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Signed revision synced across peer mesh. Guides lost members back to camp."
                        android:textColor="@color/text_slate_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <EditText
                            android:id="@+id/etMeetingPoint"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_rounded"
                            android:text="Camp Alpha (Lake Bridge)"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:paddingHorizontal="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateMeeting"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Update"
                            android:textColor="@color/bg_navy_deep"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/cyan_accent"
                            app:cornerRadius="10dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Fall Detection Calibration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏃 Sudden Fall Detection Sensor"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accelerometer impact threshold: Free-fall + Impact (>24 m/s²) + 10s stillness."
                        android:textColor="@color/text_slate_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestFallAlert"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="🧪 Simulate Sudden Hard Drop"
                        android:textColor="@color/p1_orange"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/bg_surface_dark"
                        app:strokeColor="@color/p1_orange"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Cryptography & Security -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_card_slate"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️ Mesh Cryptography &amp; Node Key"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Node ID: RESQ-NODE-TEL-01\nKey: HMAC-SHA256 (Shared Secret Fingerprint)\nRelay Mode: Automatic Store-and-Forward Repeater"
                        android:textColor="@color/text_slate_muted"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_surface_dark"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/cyan_accent"
        app:itemTextColor="@color/text_slate_light"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
