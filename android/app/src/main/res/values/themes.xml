<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ResQ" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/sos_red</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="colorOnSecondary">@color/bg_dark_navy</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark_navy</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/bg_dark_navy</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
