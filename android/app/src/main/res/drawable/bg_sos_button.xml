<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_light">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:startColor="#F87171"
                android:centerColor="#DC2626"
                android:endColor="#991B1B" />
            <stroke
                android:width="3dp"
                android:color="#4DFFFFFF" />
            <size
                android:width="200dp"
                android:height="200dp" />
        </shape>
    </item>
</ripple>
